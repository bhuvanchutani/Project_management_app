# Server (Railway sets PORT automatically)
PORT=8081

# Database — pick ONE stack and set driver + URL accordingly.
# Local H2 (default if unset): leave DB_URL empty or use the in-memory default in application.properties
# MySQL:
# DB_URL=jdbc:mysql://HOST:3306/DATABASE?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USERNAME=root
# DB_PASSWORD=secret
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# PostgreSQL (Railway plugin — use JDBC URL from the dashboard or variables below):
# SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/railway
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=secret
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# Optional Spring-style overrides (take precedence over DB_*)
# SPRING_DATASOURCE_URL=
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=

JWT_SECRET=change-this-to-a-very-long-32-char-secret-key
JWT_EXPIRATION_MS=86400000

# Comma-separated origins for browser clients (your Railway frontend URL + local dev)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JPA (production: leave ddl auto update only for demos; prefer flyway for real apps)
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
